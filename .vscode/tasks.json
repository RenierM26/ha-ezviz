{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: bootstrap",
      "type": "process",
      "command": "python",
      "args": [
        "tools/bootstrap.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: lint",
      "type": "process",
      "command": "${workspaceFolder}/.venv-tools/bin/python",
      "args": [
        "tools/check.py",
        "lint"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: standalone",
      "type": "process",
      "command": "${workspaceFolder}/.venv-tools/bin/python",
      "args": [
        "tools/check.py",
        "standalone"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: native",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/check.py",
        "native"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HA: run dev instance",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "homeassistant",
        "-c",
        "_devconfig"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
