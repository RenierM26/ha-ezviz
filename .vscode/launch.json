{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch: Home Assistant (manual)",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": [
        "-c",
        "${workspaceFolder}/_devconfig"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ]
}
